---
// src/components/Header.astro
const navLinks = [
  { href: "/", label: "Главная" },
  { href: "/about", label: "О нас" },
  { href: "/services", label: "Услуги" },
  { href: "/contacts", label: "Контакты" },
];

const siteName = "Ремонт двигателей в москве";
const currentPath = Astro.url.pathname;
---

<header
  class="sticky top-0 z-50 bg-white shadow-md"
  role="banner"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">

      <!-- Логотип / Название -->
      <a
        href="/"
        class="flex items-center gap-2 text-red-600 font-bold text-lg md:text-xl leading-tight hover:text-red-700 transition-colors"
        aria-label={`${siteName} — перейти на главную`}
      >
        <!-- Иконка двигателя -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-8 h-8 flex-shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="2" y="7" width="20" height="10" rx="2" ry="2" />
          <path d="M6 7V5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2" />
          <path d="M14 7V5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2" />
          <line x1="6" y1="12" x2="6" y2="12" />
          <line x1="12" y1="12" x2="12" y2="12" />
          <path d="M2 12h2M20 12h2" />
        </svg>
        <span class="max-w-[180px] sm:max-w-none leading-tight">
          {siteName}
        </span>
      </a>

      <!-- Десктопная навигация -->
      <nav
        class="hidden md:flex items-center gap-1"
        aria-label="Основная навигация"
      >
        <ul class="flex items-center gap-1" role="list">
          {navLinks.map((link) => {
            const isActive =
              link.href === "/"
                ? currentPath === "/"
                : currentPath.startsWith(link.href);
            return (
              <li>
                <a
                  href={link.href}
                  class:list={[
                    "px-4 py-2 rounded-md text-sm font-medium transition-colors duration-200",
                    isActive
                      ? "bg-red-600 text-white"
                      : "text-gray-700 hover:bg-red-50 hover:text-red-600",
                  ]}
                  aria-current={isActive ? "page" : undefined}
                >
                  {link.label}
                </a>
              </li>
            );
          })}
        </ul>

        <!-- CTA кнопка -->
        <a
          href="tel:+74991234567"
          class="ml-4 inline-flex items-center gap-2 bg-red-600 hover:bg-red-700 text-white text-sm font-semibold px-4 py-2 rounded-lg transition-colors duration-200"
          aria-label="Позвонить нам: +7 (499) 123-45-67"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.58 3.38 2 2 0 0 1 3.55 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.5a16 16 0 0 0 5.55 5.55l.86-.86a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
          +7 (499) 123-45-67
        </a>
      </nav>

      <!-- Мобильная: телефон + гамбургер -->
      <div class="flex items-center gap-2 md:hidden">
        <a
          href="tel:+74991234567"
          class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-red-50 text-red-600 hover:bg-red-100 transition-colors"
          aria-label="Позвонить нам"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.58 3.38 2 2 0 0 1 3.55 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.5a16 16 0 0 0 5.55 5.55l.86-.86a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
        </a>

        <!-- Гамбургер -->
        <button
          id="hamburger-btn"
          type="button"
          class="inline-flex items-center justify-center w-10 h-10 rounded-lg text-gray-700 hover:bg-gray-100 transition-colors"
          aria-label="Открыть меню навигации"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <!-- Иконка "открыто" (три полоски) -->
          <svg
            id="icon-open"
            xmlns="http://www.w3.org/2000/svg"
            class="w-6 h-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="18" x2="21" y2="18" />
          </svg>
          <!-- Иконка "закрыто" (крест) -->
          <svg
            id="icon-close"
            xmlns="http://www.w3.org/2000/svg"
            class="w-6 h-6 hidden"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Мобильное меню -->
  <nav
    id="mobile-menu"
    class="hidden md:hidden border-t border-gray-100 bg-white"
    aria-label="Мобильная навигация"
  >
    <ul class="px-4 py-3 flex flex-col gap-1" role="list">
      {navLinks.map((link) => {
        const isActive =
          link.href === "/"
            ? currentPath === "/"
            : currentPath.startsWith(link.href);
        return (
          <li>
            <a
              href={link.href}
              class:list={[
                "block px-4 py-3 rounded-lg text-base font-medium transition-colors duration-200",
                isActive
                  ? "bg-red-600 text-white"
                  : "text-gray-700 hover:bg-red-50 hover:text-red-600",
              ]}
              aria-current={isActive ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        );
      })}

      <!-- Телефон в мобильном меню -->
      <li class="mt-2 pt-2 border-t border-gray-100">
        <a
          href="tel:+74991234567"
          class="flex items-center gap-3 px-4 py-3 rounded-lg bg-red-600 text-white font-semibold hover:bg-red-700 transition-colors"
          aria-label="Позвонить нам: +7 (499) 123-45-67"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5 flex-shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.58 3.38 2 2 0 0 1 3.55 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.5a16 16 0 0 0 5.55 5.55l.86-.86a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
          +7 (499) 123-45-67
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const btn = document.getElementById('hamburger-btn') as HTMLButtonElement;
  const menu = document.getElementById('mobile-menu') as HTMLElement;
  const iconOpen = document.getElementById('icon-open') as HTMLElement;
  const iconClose = document.getElementById('icon-close') as HTMLElement;

  function toggleMenu() {
    const isExpanded = btn.getAttribute('aria-expanded') === 'true';

    btn.setAttribute('aria-expanded', String(!isExpanded));
    menu.classList.toggle('hidden');

    iconOpen.classList.toggle('hidden');
    iconClose.classList.toggle('hidden');

    btn.setAttribute(
      'aria-label',
      isExpanded ? 'Открыть меню навигации' : 'Закрыть меню навигации'
    );
  }

  btn.addEventListener('click', toggleMenu);

  // Закрытие по клавише Escape
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
      toggleMenu();
      btn.focus();
    }
  });

  // Закрытие при клике вне меню
  document.addEventListener('click', (e: MouseEvent) => {
    const target = e.target as Node;
    const header = document.querySelector('header') as HTMLElement;
    if (!header.contains(target) && btn.getAttribute('aria-expanded') === 'true') {
      toggleMenu();
    }
  });

  // Закрытие при изменении размера экрана до десктопного
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768 && btn.getAttribute('aria-expanded') === 'true') {
      toggleMenu();
    }
  });
</script>
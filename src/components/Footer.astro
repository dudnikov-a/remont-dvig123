---
// src/components/Footer.astro

const currentYear = new Date().getFullYear();

const navLinks = [
  { href: "/", label: "Главная" },
  { href: "/about", label: "О нас" },
  { href: "/services", label: "Услуги" },
  { href: "/contacts", label: "Контакты" },
];

const workingHours = [
  { day: "Понедельник — Пятница", hours: "9:00 — 20:00" },
  { day: "Суббота", hours: "10:00 — 18:00" },
  { day: "Воскресенье", hours: "Выходной" },
];
---

<footer class="bg-gray-100 border-t border-gray-200" role="contentinfo">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <!-- Три колонки -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

      <!-- Колонка 1: Контакты -->
      <div>
        <h2 class="text-lg font-bold text-gray-800 mb-4 font-playfair">
          Контакты
        </h2>
        <address class="not-italic space-y-3 text-gray-600 text-sm">

          <!-- Название -->
          <p class="font-semibold text-gray-700 text-base">
            Ремонт двигателей в москве
          </p>

          <!-- Адрес -->
          <div class="flex items-start gap-2">
            <svg
              class="w-5 h-5 text-red-600 mt-0.5 shrink-0"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"
              />
              <circle cx="12" cy="9" r="2.5" fill="currentColor" stroke="none" />
            </svg>
            <a
              href="https://maps.google.com/?q=Тушино+дом+20+Москва"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-red-600 transition-colors duration-200"
              aria-label="Открыть адрес на карте Google Maps"
            >
              Тушино, дом 20, Москва
            </a>
          </div>

          <!-- Телефон -->
          <div class="flex items-center gap-2">
            <svg
              class="w-5 h-5 text-red-600 shrink-0"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498A1 1 0 0121 15.72V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              />
            </svg>
            <a
              href="tel:+74993467079"
              class="hover:text-red-600 transition-colors duration-200"
              aria-label="Позвонить нам: +7 (499) 346 70 79"
            >
              +7 (499) 346 70 79
            </a>
          </div>

        </address>
      </div>

      <!-- Колонка 2: Навигация -->
      <div>
        <h2 class="text-lg font-bold text-gray-800 mb-4 font-playfair">
          Навигация
        </h2>
        <nav aria-label="Навигация в подвале сайта">
          <ul class="space-y-2">
            {navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-gray-600 text-sm hover:text-red-600 transition-colors duration-200 flex items-center gap-2 group"
                >
                  <span
                    class="w-1.5 h-1.5 rounded-full bg-red-600 opacity-0 group-hover:opacity-100 transition-opacity duration-200"
                    aria-hidden="true"
                  ></span>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- Колонка 3: Часы работы -->
      <div>
        <h2 class="text-lg font-bold text-gray-800 mb-4 font-playfair">
          Часы работы
        </h2>
        <ul class="space-y-3" role="list" aria-label="Расписание работы">
          {workingHours.map((item) => (
            <li class="flex flex-col sm:flex-row sm:justify-between text-sm gap-1">
              <span class="text-gray-700 font-medium">{item.day}</span>
              <span
                class:list={[
                  "font-semibold",
                  item.hours === "Выходной" ? "text-red-500" : "text-red-600",
                ]}
              >
                {item.hours}
              </span>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Разделитель -->
    <div class="border-t border-gray-300 mt-10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-gray-500">
      <p>
        &copy; {currentYear} <span class="font-medium text-gray-700">Ремонт двигателей в москве</span>. Все права защищены.
      </p>
      <p>
        Москва, Тушино, дом 20
      </p>
    </div>

  </div>
</footer>
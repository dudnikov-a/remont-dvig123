---
// src/pages/services.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Услуги — Ремонт двигателей в Москве | Автосервис в Тушино";
const description = "Полный спектр услуг по ремонту двигателей в Москве: капитальный ремонт, замена масла, диагностика, замена ГРМ. Гарантия качества и доступные цены.";

const services = [
  {
    icon: "🔩",
    title: "Капитальный ремонт двигателя",
    description: "Полная разборка, дефектовка и восстановление двигателя с заменой изношенных деталей. Растачивание цилиндров, шлифовка коленвала, замена поршневых колец и вкладышей.",
    price: "от 25 000 ₽",
    duration: "от 5 дней",
    features: [
      "Разборка и дефектовка двигателя",
      "Растачивание цилиндров",
      "Шлифовка коленвала",
      "Замена поршневых колец",
      "Замена вкладышей",
      "Сборка и обкатка"
    ]
  },
  {
    icon: "🔍",
    title: "Компьютерная диагностика",
    description: "Профессиональная диагностика двигателя с помощью современного оборудования. Выявление неисправностей на ранней стадии позволяет сэкономить на дорогостоящем ремонте.",
    price: "от 1 500 ₽",
    duration: "1-2 часа",
    features: [
      "Считывание кодов ошибок",
      "Проверка датчиков",
      "Анализ работы системы зажигания",
      "Проверка топливной системы",
      "Письменный отчёт",
      "Рекомендации по ремонту"
    ]
  },
  {
    icon: "⚙️",
    title: "Замена ГРМ",
    description: "Замена ремня или цепи газораспределительного механизма с проверкой и регулировкой фаз газораспределения. Используем только оригинальные запчасти или качественные аналоги.",
    price: "от 8 000 ₽",
    duration: "1-2 дня",
    features: [
      "Замена ремня или цепи ГРМ",
      "Замена роликов и натяжителей",
      "Замена помпы охлаждения",
      "Регулировка фаз ГРМ",
      "Проверка системы охлаждения",
      "Гарантия на работы"
    ]
  },
  {
    icon: "🛢️",
    title: "Замена масла и фильтров",
    description: "Плановая замена моторного масла и фильтров с подбором оптимального масла для вашего двигателя. Используем масла ведущих мировых производителей.",
    price: "от 2 500 ₽",
    duration: "30-60 минут",
    features: [
      "Слив старого масла",
      "Замена масляного фильтра",
      "Замена воздушного фильтра",
      "Замена топливного фильтра",
      "Доливка нового масла",
      "Проверка уровней жидкостей"
    ]
  },
  {
    icon: "💧",
    title: "Ремонт системы охлаждения",
    description: "Диагностика и ремонт системы охлаждения двигателя: замена радиатора, термостата, помпы, патрубков. Устранение течей антифриза и перегрева двигателя.",
    price: "от 4 000 ₽",
    duration: "1-3 дня",
    features: [
      "Диагностика системы охлаждения",
      "Замена радиатора",
      "Замена термостата",
      "Замена помпы",
      "Замена патрубков",
      "Промывка системы охлаждения"
    ]
  },
  {
    icon: "⚡",
    title: "Ремонт топливной системы",
    description: "Чистка и ремонт топливных форсунок, замена топливного насоса, регулятора давления топлива. Восстановление мощности двигателя и снижение расхода топлива.",
    price: "от 5 000 ₽",
    duration: "1-2 дня",
    features: [
      "Диагностика топливной системы",
      "Чистка форсунок",
      "Замена топливного насоса",
      "Замена регулятора давления",
      "Замена топливных фильтров",
      "Проверка после ремонта"
    ]
  }
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AutoRepair",
  "name": "Ремонт двигателей в Москве",
  "url": "https://remont-dvigatelei.ru",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Услуги по ремонту двигателей",
    "itemListElement": services.map((service, index) => ({
      "@type": "Offer",
      "position": index + 1,
      "name": service.title,
      "description": service.description,
      "price": service.price
    }))
  }
};
---

<BaseLayout
  title={title}
  description={description}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <main role="main">

    <!-- Hero Section -->
    <section
      class="bg-gradient-to-br from-gray-900 via-gray-800 to-red-900 text-white py-20 px-4"
      aria-labelledby="services-hero-heading"
    >
      <div class="max-w-5xl mx-auto text-center">
        <p class="text-red-400 font-semibold text-sm uppercase tracking-widest mb-4">
          Профессиональный автосервис
        </p>
        <h1
          id="services-hero-heading"
          class="text-4xl md:text-5xl font-extrabold leading-tight mb-6"
        >
          Наши услуги
        </h1>
        <p class="text-gray-300 text-lg md:text-xl max-w-2xl mx-auto mb-8">
          Полный спектр работ по ремонту и обслуживанию двигателей. Современное оборудование,
          квалифицированные мастера и гарантия на все виды работ.
        </p>
        <a
          href="tel:+74993467079"
          class="inline-block bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-8 rounded-xl transition-colors duration-200"
        >
          Записаться на ремонт
        </a>
      </div>
    </section>

    <!-- Services Section -->
    <section
      class="py-20 px-4 bg-white"
      aria-labelledby="services-list-heading"
    >
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-14">
          <h2
            id="services-list-heading"
            class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-4"
          >
            Все виды ремонта двигателей
          </h2>
          <p class="text-gray-500 text-lg max-w-2xl mx-auto">
            Мы выполняем весь спектр работ — от диагностики до капитального ремонта.
            Каждая услуга сопровождается гарантией и подробной консультацией.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {services.map((service) => (
            <article
              class="bg-gray-50 border border-gray-100 rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-shadow duration-300 flex flex-col"
              aria-label={service.title}
            >
              <!-- Card Header -->
              <div class="bg-gradient-to-br from-gray-800 to-gray-900 px-6 py-6 text-white">
                <div class="text-4xl mb-3" aria-hidden="true">{service.icon}</div>
                <h3 class="text-xl font-bold mb-2">{service.title}</h3>
                <p class="text-gray-300 text-sm leading-relaxed">{service.description}</p>
              </div>

              <!-- Card Meta -->
              <div class="flex items-center gap-6 px-6 py-4 bg-red-600 text-white">
                <div>
                  <p class="text-xs uppercase tracking-wide opacity-80">Стоимость</p>
                  <p class="font-bold text-lg">{service.price}</p>
                </div>
                <div class="border-l border-red-400 pl-6">
                  <p class="text-xs uppercase tracking-wide opacity-80">Срок</p>
                  <p class="font-bold text-lg">{service.duration}</p>
                </div>
              </div>

              <!-- Card Features -->
              <div class="px-6 py-6 flex-1">
                <p class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-4">
                  Что входит в услугу:
                </p>
                <ul class="space-y-2" role="list">
                  {service.features.map((feature) => (
                    <li class="flex items-start gap-2 text-gray-700 text-sm">
                      <span class="text-red-500 font-bold mt-0.5 shrink-0" aria-hidden="true">✓</span>
                      {feature}
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Card Footer -->
              <div class="px-6 pb-6">
                <a
                  href="tel:+74993467079"
                  class="block w-full text-center bg-gray-900 hover:bg-red-600 text-white font-semibold py-3 px-4 rounded-xl transition-colors duration-200"
                >
                  Узнать подробнее
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Process Section -->
    <section
      class="py-20 px-4 bg-gray-50"
      aria-labelledby="process-heading"
    >
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-14">
          <h2
            id="process-heading"
            class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-4"
          >
            Как мы работаем
          </h2>
          <p class="text-gray-500 text-lg max-w-xl mx-auto">
            Простой и прозрачный процесс — от первого звонка до выдачи автомобиля
          </p>
        </div>

        <ol class="grid grid-cols-1 md:grid-cols-4 gap-8" role="list">
          {[
            {
              step: "01",
              title: "Заявка",
              description: "Позвоните нам или оставьте заявку на сайте. Согласуем удобное время."
            },
            {
              step: "02",
              title: "Диагностика",
              description: "Проводим компьютерную и визуальную диагностику. Выявляем все неисправности."
            },
            {
              step: "03",
              title: "Согласование",
              description: "Называем точную стоимость и сроки. Приступаем к работе только после вашего согласия."
            },
            {
              step: "04",
              title: "Выдача",
              description: "Сдаём готовый автомобиль, объясняем выполненные работы, выдаём гарантийный талон."
            }
          ].map((item) => (
            <li class="text-center">
              <div
                class="w-16 h-16 bg-red-600 text-white text-xl font-extrabold rounded-full flex items-center justify-center mx-auto mb-4"
                aria-hidden="true"
              >
                {item.step}
              </div>
              <h3 class="text-lg font-bold text-gray-900 mb-2">{item.title}</h3>
              <p class="text-gray-500 text-sm leading-relaxed">{item.description}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Guarantee Section -->
    <section
      class="py-20 px-4 bg-white"
      aria-labelledby="guarantee-heading"
    >
      <div class="max-w-5xl mx-auto">
        <div class="bg-gradient-to-br from-gray-900 to-gray-800 rounded-3xl p-10 md:p-14 text-white">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
            <div>
              <h2
                id="guarantee-heading"
                class="text-3xl md:text-4xl font-extrabold mb-6"
              >
                Гарантия на все виды работ
              </h2>
              <p class="text-gray-300 text-lg leading-relaxed mb-6">
                Мы уверены в качестве своей работы, поэтому предоставляем официальную
                гарантию на все выполненные услуги. В случае возникновения проблем —
                устраняем их бесплатно.
              </p>
              <a
                href="tel:+74993467079"
                class="inline-block bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-8 rounded-xl transition-colors duration-200"
              >
                Задать вопрос
              </a>
            </div>
            <ul class="space-y-4" role="list">
              {[
                { icon: "🛡️", title: "До 12 месяцев", desc: "гарантия на капитальный ремонт" },
                { icon: "📋", title: "Письменный договор", desc: "на все виды работ" },
                { icon: "🔧", title: "Бесплатное устранение", desc: "гарантийных случаев" },
                { icon: "📞", title: "Поддержка 24/7", desc: "консультация после ремонта" }
              ].map((item) => (
                <li class="flex items-start gap-4">
                  <span class="text-3xl shrink-0" aria-hidden="true">{item.icon}</span>
                  <div>
                    <p class="font-bold text-white">{item.title}</p>
                    <p class="text-gray-400 text-sm">{item.desc}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section
      class="py-20 px-4 bg-red-600 text-white"
      aria-labelledby="services-cta-heading"
    >
      <div class="max-w-3xl mx-auto text-center">
        <h2
          id="services-cta-heading"
          class="text-3xl md:text-4xl font-extrabold mb-6"
        >
          Не откладывайте ремонт двигателя
        </h2>
        <p class="text-red-100 text-lg mb-10">
          Своевременное обслуживание предотвратит дорогостоящий ремонт.
          Запишитесь прямо сейчас — первая диагностика бесплатно!
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="tel:+74993467079"
            class="inline-block bg-white text-red-600 hover:bg-red-50 font-bold py-4 px-10 rounded-xl transition-colors duration-200 text-lg"
          >
            📞 +7 (499) 346-70-79
          </a>
          <a
            href="/contacts"
            class="inline-block bg-transparent border-2 border-white text-white hover:bg-white hover:text-red-600 font-bold py-4 px-10 rounded-xl transition-colors duration-200 text-lg"
          >
            Как нас найти
          </a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>